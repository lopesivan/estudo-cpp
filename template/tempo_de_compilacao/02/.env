### 💡 C++20: /home/linuxbrew/.linuxbrew/bin/g++-16
CC = /home/linuxbrew/.linuxbrew/bin/g++-16 -std=c++2b -O0 -Werror -Wconversion -Wpedantic -c -o {}.o {}.cpp
### 💡 Adicionando `-fsanitize=address` (debug de memória):
#CC = g++-14 -std=c++23 -g -O0 -fsanitize=address -fno-omit-frame-pointer -Wall -Wextra -c -o {}.o {}.cpp
#LD = g++-14 -fsanitize=address -lm {}.o -o {}

## 🟣 Versões com `clang++`
#CC = clang++ -std=c++23 -g -O0 -Wall -Wextra -Wshadow -Wpedantic -Wno-parentheses -c -o {}.o {}.cpp
#LD = clang++ -lm {}.o -o {}

### 💡 Clang com `-stdlib=libc++` (opcional, para testar compatibilidade com libc++):
### UBUNTU: sudo apt install libc++-dev libc++abi-dev
#CC = clang++ -std=c++23 -stdlib=libc++ -g -O0 -Wall -Wextra -c -o {}.o {}.cpp
#LD = clang++ -stdlib=libc++ -lm {}.o -o {}

### 💡 Clang sem `-stdlib=libc++` (opcional, para testar compatibilidade com libc++):
#CC = clang++ -std=c++23 -g -O0 -Wall -Wextra -c -o {}.o {}.cpp
